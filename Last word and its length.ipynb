   "source": [
    "#write a program to get the last word and its length from the string \n",
    "\n",
    "str=input(\"enter the str:\")\n",
    "i=len(str)-1\n",
    "while i>=0 and str[i]==' ':\n",
    "    i-=1\n",
    "end=i\n",
    "count=0\n",
    "while i>=0 and str[i]!=' ':\n",
    "    count+=1\n",
    "    i-=1\n",
    "last_word=str[i+1:end+1]\n",
    "print(\"last word\",last_word)\n",
    "print(count)\n"
   ]
